---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import Crumb from '../components/Crumb.astro';
import CardGrid from '../components/CardGrid.astro';
import { getListings, byDateDescending } from '../lib/listings.ts';
import { getTree, resolvePath, genusOf } from '../lib/tree.ts';
import { HABITAT_BY_SLUG } from '../lib/habitats.ts';
import { formatDate } from '../lib/format.ts';
import { asset, habitatUrl, listingUrl } from '../lib/url.ts';

export const getStaticPaths = (() => {
  const listings = getListings();
  const chronological = byDateDescending(listings);

  return chronological.map((listing, i) => ({
    // The slug comes verbatim from WordPress and is never regenerated, so
    // every existing weedsofmelbourne.org link keeps working (SPEC §2).
    params: { slug: listing.slug },
    props: {
      listing,
      newer: chronological[i - 1] ?? null,
      older: chronological[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { listing, newer, older } = Astro.props;
const listings = getListings();
const tree = getTree(listings);

const crumb = resolvePath(tree, listing.path);
const genus = genusOf(listing);
const siblings = genus
  ? listings.filter(
      (l) => l.slug !== listing.slug && l.path.some((p) => p.rank === 'genus' && p.name === genus.name),
    )
  : [];

const lead = listing.gallery[0];
const site = Astro.site ?? new URL('https://weedsofmelbourne.org');
const canonical = new URL(listingUrl(listing.slug), site).href;

const query = encodeURIComponent(listing.binomial || listing.common);
const elsewhere = [
  { where: 'VicFlora', label: `Search VicFlora for ${listing.binomial || listing.common}`, href: `https://vicflora.rbg.vic.gov.au/flora/search?query=${query}` },
  { where: 'Atlas of Living Australia', label: `${listing.binomial || listing.common} occurrence records`, href: `https://bie.ala.org.au/search?q=${query}` },
];
if (listing.instagram) {
  elsewhere.push({ where: 'Instagram', label: 'The original post', href: listing.instagram });
}
---

<BaseLayout
  title={`${listing.common}${listing.binomial ? ` (${listing.binomial})` : ''}`}
  description={listing.summary}
  path={`/${listing.slug}/`}
  image={lead ? asset(`${lead.src}-900.webp`) : undefined}
  imageAlt={`${listing.common} (${listing.binomial})`}
  ogType="article"
>
  <article class="wrap listing">
    <Gallery images={listing.gallery} common={listing.common} binomial={listing.binomial} />

    {listing.habitats.length > 0 && (
      <nav class="pills" aria-label="Habitats">
        {listing.habitats.map((slug) => (
          <a class="pill" href={habitatUrl(slug)}>{HABITAT_BY_SLUG.get(slug)?.label ?? slug}</a>
        ))}
      </nav>
    )}

    <h1>{listing.common}</h1>
    {listing.binomial && <p class="binomial">{listing.binomial}</p>}

    <div class="byline">
      {listing.date && <time class="mono" datetime={listing.date}>{formatDate(listing.date)}</time>}
      <span class="mono slug">/{listing.slug}/</span>
      <button
        type="button"
        class="copy-link"
        data-copy-link={canonical}
        hidden
      >
        <span data-copy-label>Copy link</span>
      </button>
    </div>

    <div class="listing-body">
      <div>
        <div class="prose measure">
          {listing.summary && <p class="lede">{listing.summary}</p>}
          {listing.body.slice(listing.body[0] === listing.summary ? 1 : 0).map((para) => (
            <p>{para}</p>
          ))}
        </div>

        {crumb.length > 0 && (
          <section class="section" aria-labelledby="where-it-sits">
            <div class="section-head"><h2 id="where-it-sits">Where it sits</h2></div>
            <Crumb path={crumb} label="Classification of this plant" />
          </section>
        )}

        <section class="section" aria-labelledby="elsewhere">
          <div class="section-head"><h2 id="elsewhere">Elsewhere</h2></div>
          <div class="links-list">
            {elsewhere.map((link) => (
              <a href={link.href} rel="noopener noreferrer external">
                <span>{link.label}</span>
                <span class="where">{link.where}</span>
              </a>
            ))}
          </div>
        </section>

        {siblings.length > 0 && (
          <section class="section" aria-labelledby="siblings">
            <div class="section-head">
              <h2 id="siblings">Other <em>{genus?.name}</em> on this site</h2>
              <span class="count">{siblings.length}</span>
            </div>
            <CardGrid listings={siblings} />
          </section>
        )}

        <nav class="prevnext" aria-label="More listings">
          {older ? (
            <a class="prev" href={listingUrl(older.slug)}>
              <span class="label dir">← Earlier</span>
              <span class="who">{older.common}</span>
            </a>
          ) : <span></span>}
          {newer ? (
            <a class="next" href={listingUrl(newer.slug)}>
              <span class="label dir">Later →</span>
              <span class="who">{newer.common}</span>
            </a>
          ) : <span></span>}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
