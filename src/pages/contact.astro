---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEMO, SOURCE_SITE, SOURCE_URL } from '../lib/site.ts';
---

<BaseLayout
  title="Contact"
  description={`How to get in touch about this rebuild, and where to find the original ${SOURCE_SITE}.`}
  path="/contact/"
>
  <div class="wrap">
    <section class="hero">
      <p class="label">Contact</p>
      <h1>Get in touch</h1>
    </section>

    <section class="section">
      <div class="prose measure">
        {DEMO ? (
          <Fragment>
            <p class="lede">
              This site is an unofficial rebuild. There are two different things
              you might want, and they go to different places.
            </p>
            <h2>About a plant</h2>
            <p>
              Corrections to an identification, a name, or anything in a plant’s
              description belong with
              <a href={SOURCE_URL} rel="noopener noreferrer external">{SOURCE_SITE}</a>,
              whose work all of it is. We have not changed a word of it and are
              not in a position to correct it.
            </p>
            <h2>About this rebuild</h2>
            <p>
              Anything about the site itself — a page that renders badly, a
              search that misses something obvious, a broken address — is ours.
              The quickest route is an issue on the repository this is built
              from; the address of any listing is shown under its title, with a
              button to copy it.
            </p>
          </Fragment>
        ) : (
          <Fragment>
            <p class="lede">
              Corrections are welcome — a misapplied name, a better
              identification, a plant that should be here and is not.
            </p>
            <p>
              Include the listing’s address if you are writing about a
              particular plant; it is shown under the title on every page and
              there is a button to copy it.
            </p>
          </Fragment>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
