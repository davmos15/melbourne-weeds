---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * PLACEHOLDER COPY. The live site's contact details could not be fetched
 * during the build (see MIGRATION.md) — put Adi's real address and handle in
 * before launch. There is no form: the site is static, so a form would need a
 * third-party endpoint.
 */
---

<BaseLayout
  title="Contact"
  description="Get in touch about Weeds of Melbourne — corrections, identifications and requests."
  path="/contact/"
>
  <div class="wrap">
    <section class="hero">
      <p class="label">Contact</p>
      <h1>Get in touch</h1>
    </section>

    <section class="section">
      <div class="prose measure">
        <p class="lede">
          Corrections are welcome — a misapplied name, a better identification,
          a plant that should be here and is not.
        </p>
        <p>
          The quickest way is a message on Instagram, where most of these
          photographs are posted first. Include the listing’s address if you are
          writing about a particular plant; it is shown under the title on every
          page and there is a copy button beside it.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
