---
import type { Listing } from '../lib/types.ts';
import Card from './Card.astro';

interface Props {
  listings: Listing[];
  empty?: string;
}

const { listings, empty = 'Nothing here yet.' } = Astro.props;
---

{
  listings.length ? (
    <div class="grid">
      {listings.map((listing, i) => (
        <Card listing={listing} eager={i < 4} />
      ))}
    </div>
  ) : (
    <p class="empty">{empty}</p>
  )
}
