---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
  label?: string;
}

const { page, label = 'Pagination' } = Astro.props;

/** 1 … 4 5 [6] 7 8 … 20 — never more than nine cells on a 360px screen. */
function window_(current: number, last: number): (number | '…')[] {
  const out: (number | '…')[] = [];
  const near = new Set<number>([1, last, current, current - 1, current + 1]);
  if (current <= 3) [2, 3, 4].forEach((n) => near.add(n));
  if (current >= last - 2) [last - 3, last - 2, last - 1].forEach((n) => near.add(n));
  const pages = [...near].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
  pages.forEach((n, i) => {
    if (i > 0 && n - pages[i - 1] > 1) out.push('…');
    out.push(n);
  });
  return out;
}

const cells = page.lastPage > 1 ? window_(page.currentPage, page.lastPage) : [];
---

{
  cells.length > 0 && (
    <nav class="pager" aria-label={label}>
      {page.url.prev ? (
        <a href={page.url.prev} rel="prev">← Prev</a>
      ) : (
        <span class="gap" aria-hidden="true">← Prev</span>
      )}
      {cells.map((cell) =>
        cell === '…' ? (
          <span class="gap" aria-hidden="true">…</span>
        ) : cell === page.currentPage ? (
          <span aria-current="page">{cell}</span>
        ) : (
          <a href={cell === 1 ? page.url.first ?? page.url.current : `${(page.url.first ?? '/all/').replace(/\/$/, '')}/${cell}/`}>
            {cell}
          </a>
        ),
      )}
      {page.url.next ? (
        <a href={page.url.next} rel="next">Next →</a>
      ) : (
        <span class="gap" aria-hidden="true">Next →</span>
      )}
    </nav>
  )
}
