---
import { u } from '../lib/url.ts';
import { DEMO, SOURCE_SITE, SOURCE_URL } from '../lib/site.ts';
---

<footer class="footer">
  <div class="wrap">
    <nav aria-label="Secondary">
      <a href={u('/all/')}>All listings</a>
      <a href={u('/tree/')}>Classification</a>
      <a href={u('/about/')}>About</a>
      <a href={u('/references/')}>References</a>
      <a href={u('/contact/')}>Contact</a>
    </nav>
    <p>
      A visual glossary of the naturalised and weedy flora of Melbourne.
    </p>
    {DEMO && (
      <p class="attribution">
        <strong>Unofficial rebuild.</strong> All photographs and text are the work of
        <a href={SOURCE_URL} rel="noopener noreferrer external">{SOURCE_SITE}</a>
        and remain their copyright, reproduced here without their endorsement while
        this rebuild is shown to them. Not affiliated with {SOURCE_SITE}.
      </p>
    )}
  </div>
</footer>
