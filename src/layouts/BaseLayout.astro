---
import '../styles/base.css';
import fontFaces from '../styles/fonts.css?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u } from '../lib/url.ts';
import { DEMO } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  /** Route of this page, e.g. "/caltrop-tribulus-terrestris/" — for canonical. */
  path: string;
  /** Absolute or site-relative image for og:image. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** The page's LCP image, preloaded so it is not queued behind the fonts. */
  preload?: { srcset: string; sizes: string; type?: string };
  /** Which top-level nav item to mark as current. */
  nav?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  image,
  imageAlt,
  ogType = 'website',
  nav,
  noindex = false,
  preload,
} = Astro.props;

const site = Astro.site ?? new URL('https://weedsofmelbourne.org');
const canonical = new URL(u(path), site).href;
const ogImage = image ? new URL(image, site).href : undefined;

// The @font-face block is generated by scripts/fonts.ts and carries a
// `__BASE__` token so the woff2 URLs follow the configured base path.
const fontCss = fontFaces.replaceAll('__BASE__', import.meta.env.BASE_URL || '/');

const fullTitle = title === 'Weeds of Melbourne' ? title : `${title} — Weeds of Melbourne`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Demo mode keeps the whole site out of search while permission is
        pending, so it cannot rank against the site it is a copy of. */}
    {(noindex || DEMO) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content="Weeds of Melbourne" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={imageAlt ?? title} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#2B2F2B" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />

    <!-- The LCP image goes first. The fonts are self-hosted (no third-party
         connection on a mobile network) and carry font-display: swap, so text
         paints in the metric-matched fallback immediately and they do not need
         to win the race — preloading them only pushed them ahead of the image
         that does. Measured: doing this the other way round cost ~0.7 s of LCP
         on a listing page. -->
    {preload && (
      <link
        rel="preload"
        as="image"
        type={preload.type}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        fetchpriority="high"
      />
    )}
    <style set:html={fontCss}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header nav={nav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
